<Window x:Class="CallReceiver.Views.CallPopupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
 ShowActivated="False" Focusable="False">
 <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Padding="12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="TitleText"/>
   <Button Content="X" HorizontalAlignment="Right" Focusable="False" Click="CloseClick" MinWidth="28"/>
   <TextBlock x:Name="NumberText" Grid.Row="1" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   <TextBlock x:Name="TimeText" Grid.Row="2"/>
  </Grid>
 </Border>
</Window>
