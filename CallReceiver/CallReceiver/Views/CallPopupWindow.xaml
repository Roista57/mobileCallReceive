<Window x:Class="CallReceiver.Views.CallPopupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
 ShowActivated="False" Focusable="False">
 <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Padding="12">
  <Grid ClipToBounds="True">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="TitleText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    <Button Grid.Column="1" Content="X" Focusable="False" Click="CloseClick" MinWidth="28"/>
   </Grid>
   <Grid x:Name="BodyGrid" Grid.Row="1" ClipToBounds="True">
    <TextBlock x:Name="NumberText" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="TimeText" TextTrimming="CharacterEllipsis"/>
   </Grid>
  </Grid>
 </Border>
</Window>
