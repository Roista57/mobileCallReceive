<Window x:Class="CallReceiver.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="전화 수신 설정" Width="820" Height="620" MinWidth="680" MinHeight="500"
 WindowStartupLocation="CenterScreen">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <TextBlock Text="{Binding DirtyText}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
   <Button Content="설정 저장" Command="{Binding SaveCommand}" HorizontalAlignment="Right" MinWidth="100" Margin="0,6,0,0"/>
  </StackPanel>
  <TabControl>
   <TabItem Header="서버 설정">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="10">
      <GroupBox Header="HTTP 서버 상태" Margin="0,0,0,10">
       <Grid Margin="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <Label Content="상태"/><TextBlock Grid.Column="1" Text="{Binding ServerStatus}" FontWeight="Bold" VerticalAlignment="Center"/>
        <Label x:Name="CurrentAddressLabel" Grid.Row="1" Content="현재 주소"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Listening}" VerticalAlignment="Center"/>
       </Grid>
      </GroupBox>
      <GroupBox Header="수신 설정">
       <Grid Margin="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <Label Content="PC IPv4"/><TextBox Grid.Column="1" Text="{Binding ListenAddress, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
        <Label Grid.Row="1" Content="Port (1~65535)"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ListenPort, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
        <Label Grid.Row="2" Content="API Path (1~200자)"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ApiPath, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
       </Grid>
      </GroupBox>
      <WrapPanel Margin="0,8,0,0">
       <Button Content="모니터 새로고침" Command="{Binding RefreshCommand}" Margin="0,0,6,0"/>
       <Button Content="서버 시작" Command="{Binding StartCommand}" IsEnabled="{Binding CanStartServer}" Margin="0,0,6,0"/>
       <Button Content="서버 중지" Command="{Binding StopCommand}" IsEnabled="{Binding CanStopServer}" Margin="0,0,6,0"/>
       <Button Content="HTTP 서버 테스트" Command="{Binding HealthCommand}"/>
      </WrapPanel>
      <TextBlock Margin="0,8,0,0" Text="기본 주소 127.0.0.1은 PC 자체 테스트용입니다. 실제 스마트폰에는 PC의 LAN IPv4를 입력하세요." TextWrapping="Wrap"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="알림 설정">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="10">
      <GroupBox Header="위치와 크기">
       <Grid Margin="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <Label Content="모니터"/><ComboBox Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding Monitors}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Monitor}" Margin="4"/>
        <Label Grid.Row="1" Content="X"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PopupX, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
        <Label Grid.Row="1" Grid.Column="2" Content="Y"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding PopupY, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
        <Label Grid.Row="2" Content="Width (1~2000)"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PopupWidth, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
        <Label Grid.Row="2" Grid.Column="2" Content="Height (1~1200)"/><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding PopupHeight, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
       </Grid>
      </GroupBox>
      <GroupBox Header="표시" Margin="0,10,0,0">
       <Grid Margin="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="100"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <Label Content="표시 시간 (1~9999초)"/><TextBox Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DisplayDurationSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
        <Label Grid.Row="1" Content="안내 문구 (1~100자)"/><TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding NotificationText, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
        <Label Grid.Row="2" Content="전화번호 크기 (0~100)"/><TextBox x:Name="PhoneFontSizeBox" Grid.Row="2" Grid.Column="1" Width="56" MaxLength="3" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Text="{Binding PhoneFontSize, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="IntegerTextInput" DataObject.Pasting="IntegerPaste" Margin="4"/>
        <Label Grid.Row="2" Grid.Column="2" Content="전화번호 굵기"/><ComboBox x:Name="PhoneFontWeightBox" Grid.Row="2" Grid.Column="3" MinWidth="80" HorizontalAlignment="Left" SelectedValuePath="Content" SelectedValue="{Binding PhoneFontWeight}" Margin="4"><ComboBoxItem Content="Normal"/><ComboBoxItem Content="Bold"/></ComboBox>
        <Label Grid.Row="3" Content="수신시간 크기 (0~100)"/><TextBox x:Name="TimeFontSizeBox" Grid.Row="3" Grid.Column="1" Width="56" MaxLength="3" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Text="{Binding TimeFontSize, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="IntegerTextInput" DataObject.Pasting="IntegerPaste" Margin="4"/>
        <Label Grid.Row="3" Grid.Column="2" Content="수신시간 굵기"/><ComboBox x:Name="TimeFontWeightBox" Grid.Row="3" Grid.Column="3" MinWidth="80" HorizontalAlignment="Left" SelectedValuePath="Content" SelectedValue="{Binding TimeFontWeight}" Margin="4"><ComboBoxItem Content="Normal"/><ComboBoxItem Content="Bold"/></ComboBox>
<Label Grid.Row="4" Content="상단 순서"/><WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"><Label Content="1번"/><ComboBox x:Name="TitleItem1Box" MinWidth="100" Margin="4" ItemsSource="{Binding TitleChoices1}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding TitleItem1}"><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="IsEnabled" Value="{Binding IsEnabled}"/></Style></ComboBox.ItemContainerStyle></ComboBox><Label Content="2번"/><ComboBox x:Name="TitleItem2Box" MinWidth="100" Margin="4" ItemsSource="{Binding TitleChoices2}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding TitleItem2}"><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="IsEnabled" Value="{Binding IsEnabled}"/></Style></ComboBox.ItemContainerStyle></ComboBox><Label Content="3번"/><ComboBox x:Name="TitleItem3Box" MinWidth="100" Margin="4" ItemsSource="{Binding TitleChoices3}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding TitleItem3}"><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="IsEnabled" Value="{Binding IsEnabled}"/></Style></ComboBox.ItemContainerStyle></ComboBox></WrapPanel>
<Label Grid.Row="7" Content="전화번호 문구 (0~100자)"/><TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" MaxLength="100" Text="{Binding PhonePrefix, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
<Label Grid.Row="8" Content="수신시간 문구 (0~100자)"/><TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" MaxLength="100" Text="{Binding TimePrefix, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
<Label Grid.Row="9" Content="전화번호 정렬"/><ComboBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Left" MinWidth="80" SelectedValuePath="Tag" SelectedValue="{Binding PhoneAlignment}" Margin="4"><ComboBoxItem Tag="Left" Content="좌측"/><ComboBoxItem Tag="Center" Content="중앙"/><ComboBoxItem Tag="Right" Content="우측"/></ComboBox>
<Label Grid.Row="10" Content="수신시간 정렬"/><ComboBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Left" MinWidth="80" SelectedValuePath="Tag" SelectedValue="{Binding TimeAlignment}" Margin="4"><ComboBoxItem Tag="Left" Content="좌측"/><ComboBoxItem Tag="Center" Content="중앙"/><ComboBoxItem Tag="Right" Content="우측"/></ComboBox>
        <Label Grid.Row="11" Content="상단 시간 형식"/><ComboBox Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="3" IsEditable="True" ItemsSource="{Binding TimeFormats}" Text="{Binding TitleTimeFormat, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
        <Label Grid.Row="12" Content="본문 시간 형식"/><ComboBox Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="3" IsEditable="True" ItemsSource="{Binding TimeFormats}" Text="{Binding BodyTimeFormat, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
        <Label Grid.Row="5"><TextBlock Text="테스트 전화번호 (1~128자)" TextWrapping="Wrap"/></Label><TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" MaxLength="128" Text="{Binding TestPhoneNumber, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
        <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal"><CheckBox Content="항상 위" IsChecked="{Binding TopMost}" Margin="4"/><CheckBox Content="알림음" IsChecked="{Binding PlaySound}" Margin="12,4,4,4"/></StackPanel>
       </Grid>
      </GroupBox>
      <Button Content="알림 위치 테스트" Command="{Binding PreviewCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="프로그램 설정">
    <StackPanel Margin="10">
     <GroupBox Header="설정 파일 위치">
      <StackPanel Margin="8">
       <TextBox Text="{Binding SettingsDirectory, Mode=OneWay}" IsReadOnly="True"/>
       <WrapPanel Margin="0,6,0,0"><Button Content="설정 폴더 선택" Command="{Binding ChooseSettingsDirectoryCommand}" Margin="0,0,6,0"/><Button Content="실행 파일 위치로 되돌리기" Command="{Binding ResetSettingsDirectoryCommand}"/></WrapPanel>
       <TextBlock Margin="0,6,0,0" Text="위치 변경은 프로그램을 다시 시작한 뒤 적용됩니다."/>
      </StackPanel>
     </GroupBox>
     <CheckBox Content="Windows 로그인 시 자동 실행" IsChecked="{Binding StartWithWindows}" Margin="4,10,4,4"/>
     <CheckBox Content="설정 창을 닫으면 트레이로 이동" IsChecked="{Binding MinimizeToTray}" Margin="4"/>
     <Button x:Name="ResetSettingsButton" Content="설정 초기화" Command="{Binding ResetSettingsCommand}" HorizontalAlignment="Left" Margin="4,10,4,4"/>
    </StackPanel>
   </TabItem>
   <TabItem Header="최근 요청">
    <DockPanel Margin="10">
     <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="ClearLogButton" Content="로그 초기화" Command="{Binding ClearLogCommand}" Margin="0,0,6,0"/>
      <Button x:Name="ExportLogButton" Content="TXT로 저장" Command="{Binding ExportLogCommand}"/>
     </StackPanel>
     <ListBox ItemsSource="{Binding Log.Entries}" DisplayMemberPath="Display"/>
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
